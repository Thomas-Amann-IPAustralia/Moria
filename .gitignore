# The owner's private territory context (D-006): never commit
config/territories.context.yaml

# Secrets and local environments
.env
.env.*
!.env.example

# Local data, caches and build outputs (the system of record is the private R2 bucket)
/data/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# The dashboard's private bundle never goes in the repo: only the public and practice bundles do (D-030)
dashboard/data/*
!dashboard/data/public.json
!dashboard/data/practice.json
